{
  "name": "charles-almond-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Charles Almond professional portfolio site",
  "scripts": {
    "sass:build": "sass assets/scss/main.scss assets/css/main.css --style=expanded --source-map",
    "sass:watch": "sass --watch assets/scss/main.scss:assets/css/main.css --style=expanded --source-map",
    "sass:prod": "sass assets/scss/main.scss assets/css/main.css --style=compressed --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.101.6"
  }
}
